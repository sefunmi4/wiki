# OS noise
.DS_Store
Thumbs.db
*~
*.swp

# Obsidian local state — keep config + plugins, exclude per-machine state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspaces.json
.obsidian/cache
.obsidian/plugins/*/data.json

# Backup files
*.bak
*.backup
punchlist.md.bak

# Stray probe file from the migration (please rm manually)
.git_init_test_*

# Lock files from agent coordination (local only)
.lane-lock-*
docs/.lane-lock-*

# Temp files
_strategos-memory-pending.md
_write_test_*

# Large or sensitive content (review before adding back)
# Uncomment if you decide to exclude:
# life/*.xlsx
# life/csv-inbox/

# Derived/rebuildable index artifacts (per Wave 8B Principle 2, ratified 2026-05-24)
# _indexes/ holds PageRank scores, backlink graphs, tag indexes, vector embeddings cache.
# Rebuild via: python _scripts/indexes/run_all.py
# The .gitkeep file inside is intentionally tracked to preserve the directory.
_indexes/*
!_indexes/.gitkeep
